{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile --filter=!@faceon/desktop",
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(exclude)google-addon' ':(exclude)desktop'",
  "crons": [
    {
      "path": "/api/cron/sweep",
      "schedule": "0 5 * * *"
    }
  ]
}
