# Settings for building the desktop app, read by desktop/scripts from desktop/.env.local
# (git-ignored; copy this file there). desktop/RELEASING.md explains each one.

# The site the app opens. Leave empty for https://joinfaceon.app.
FACEON_APP_URL=
# The app's name and ID. Leave empty for FaceOn and app.joinfaceon.desktop.
NEXT_PUBLIC_APP_NAME=
DESKTOP_APP_ID=

# Updates and downloads: the public repository whose GitHub Releases hold the app (this
# one), as owner/name, and a token that can write its releases (only for publishing).
DESKTOP_RELEASES_REPO=
GH_TOKEN=

# Windows signing with Azure Artifact Signing ("Signing on Windows"): the endpoint of the
# account's region (https://eus.codesigning.azure.net for East US), the account's name and
# the certificate profile's name. It signs as whoever ran `az login` on this PC.
ARTIFACT_SIGNING_ENDPOINT=
ARTIFACT_SIGNING_ACCOUNT=
ARTIFACT_SIGNING_PROFILE=
# The name on that certificate, as `pnpm desktop:win` shows it. Installed apps then accept
# only updates signed with it.
WINDOWS_PUBLISHER_NAME=

# Mac notarization: one of these. A keychain profile is simplest ("Signing on your Mac",
# step 4).
APPLE_KEYCHAIN_PROFILE=
# APPLE_API_KEY=/path/to/AuthKey_XXXXXXXXXX.p8
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER=
