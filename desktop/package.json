{
  "name": "@faceon/desktop",
  "version": "0.1.1",
  "private": true,
  "description": "FaceOn for macOS and Windows",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/main.cjs",
  "scripts": {
    "electron:fetch": "node scripts/fetch-electron.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/fetch-electron.mjs && node scripts/build.mjs --dev && node scripts/app-id.mjs --dev && electron .",
    "icons": "node scripts/icons.mjs",
    "dist:mac": "node scripts/mac.mjs",
    "dist:win": "node scripts/windows.mjs",
    "test:e2e": "node scripts/fetch-electron.mjs && node tests/smoke.mjs",
    "try": "node scripts/fetch-electron.mjs && node scripts/try.mjs"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "esbuild": "0.28.2",
    "zod": "^4.6.7"
  }
}
