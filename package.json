{
  "name": "face-on",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/effects-assets.ts && node scripts/noise-assets.ts && node google-addon/build.mjs --bundle && next dev",
    "build": "node scripts/effects-assets.ts && node scripts/noise-assets.ts && node google-addon/build.mjs --bundle && next build",
    "start": "next start",
    "lint": "eslint src scripts tests google-addon desktop/src desktop/tests desktop/scripts *.ts *.mjs",
    "typecheck": "node google-addon/build.mjs --bundle && next typegen && tsc --noEmit && tsc -p google-addon && tsc -p desktop/tsconfig.json",
    "test": "node google-addon/build.mjs --bundle && vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:nightly": "playwright test --project=nightly-chromium --project=nightly-firefox",
    "format": "prettier --write src scripts tests google-addon desktop *.ts *.mjs *.json *.md",
    "format:check": "prettier --check src scripts tests google-addon desktop *.ts *.mjs *.json *.md",
    "stream:setup": "node --env-file=.env.local scripts/setup-stream.ts",
    "stream:check": "node --env-file=.env.local scripts/setup-stream.ts --check",
    "stream:lockdown-test": "node --env-file=.env.local scripts/stream-lockdown-test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "node --env-file=.env.local scripts/db-check.ts",
    "brand": "node scripts/brand.ts",
    "addon:build": "pnpm --filter @faceon/google-addon build",
    "addon:login": "pnpm --filter @faceon/google-addon login",
    "addon:push": "pnpm --filter @faceon/google-addon push",
    "desktop:dev": "pnpm --filter @faceon/desktop dev",
    "desktop:try": "pnpm --filter @faceon/desktop try",
    "desktop:mac": "pnpm --filter @faceon/desktop dist:mac",
    "desktop:win": "pnpm --filter @faceon/desktop dist:win",
    "desktop:icons": "pnpm --filter @faceon/desktop icons"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@internationalized/date": "3.12.4",
    "@mediapipe/tasks-vision": "1.2.0",
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "@sentry/browser": "11.10.0",
    "@sentry/nextjs": "11.10.0",
    "@stream-io/node-sdk": "^0.8.15",
    "@stream-io/video-react-sdk": "^1.45.0",
    "@vercel/functions": "^3.10.5",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "jose": "6.2.14",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-aria": "3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rrule-temporal": "2.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "temporal-polyfill": "1.0.6",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "opentype.js": "1.3.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.6"
}
