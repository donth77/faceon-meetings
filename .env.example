# Copy to .env.local for local development. Never commit real values.
# Only NEXT_PUBLIC_* values reach the browser.

# App
# The name shown everywhere. `pnpm brand` makes the logo, icons and colors to match
# (DEPLOY.md, "Make it yours").
NEXT_PUBLIC_APP_NAME=FaceOn
# The public origin. On Vercel, set it to the production domain for Production and Preview:
# preview deployments send Google and GitHub sign-in through it.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public repo for "Found an issue? Submit" / "View source on GitHub"; leave empty to hide both links
NEXT_PUBLIC_REPO_URL=
# Who runs this copy and how to reach them, as the privacy policy and terms say (/privacy, /terms).
# Without an email, they point people to the repo's issues.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
# Whose laws govern the terms, after "the laws of", e.g. "the State of New York, USA". Without it,
# the terms name the place where the operator is based.
NEXT_PUBLIC_OPERATOR_JURISDICTION=
# AI notes (made in hosts' browsers, on-device or with their own AI key): "on" (the default) or "off"
NEXT_PUBLIC_AI_NOTES=

# Database (Neon): pooled URL for the app, direct URL for migrations and backups
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Wake a sleeping database when someone starts to sign in or join, so they don't wait the
# second it takes: "auto" (the default) does it for Neon, which sleeps after five idle
# minutes unless that's turned off; "off" if yours never sleeps; "on" for another database
# that sleeps.
DATABASE_WAKE_ON_INTENT=

# Auth (Better Auth + OAuth apps)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Calendar sync for hosts who connect it (Settings → Calendar): "on" (the default) or
# "off". It uses the Google client above: turn on the Google Calendar API in its Google Cloud
# project and add the calendar.events.owned scope to its consent screen. Off leaves the
# calendar links on each meeting's page.
GOOGLE_CALENDAR_SYNC=
# FaceOn in Google Calendar and Gmail: people add their own copy of the add-on
# (google-addon/) from Settings → Calendar. "on" (the default) or "off". It uses the Google
# client above: turn on the Apps Script API in its Google Cloud project and add the
# script.projects scope to its consent screen. It needs the site on https://.
GOOGLE_ADDON=
# The logo Calendar shows beside a meeting from the add-on, for a copy with its own name.
# Google shows one only from its own servers (a draft Marketplace listing's icon, say).
GOOGLE_ADDON_CONFERENCE_LOGO_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: more origins that may use sign-in (comma-separated exact origins, e.g. a second
# domain). Production, each Vercel deployment's own address and localhost (in development)
# are trusted already. Never use a wildcard: a password-reset link must only lead back here.
BETTER_AUTH_TRUSTED_ORIGINS=
# Account emails (verify your address, reset your password) through Resend. Without it (or
# Mailtrap below), email sign-up is hidden in production; in development the emails print
# to the server log. EMAIL_FROM uses a domain verified in Resend, e.g.
# FaceOn <no-reply@mail.example.com>
RESEND_API_KEY=
EMAIL_FROM=
# Optional backup: Mailtrap sends the emails that go now when Resend is at its limit or
# down; reminders stay with Resend, which can schedule them. An API token limited to your
# sending domain (Mailtrap: Settings → API Tokens), on a domain verified in Mailtrap.
# MAILTRAP_FROM is its sender; EMAIL_FROM when empty.
MAILTRAP_API_KEY=
MAILTRAP_FROM=
# Signs guest cookies and rejoin tickets
GUEST_SESSION_SECRET=

# Media providers, in priority order: stream, livekit
MEDIA_PROVIDERS=stream
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=
STREAM_SYSTEM_USER_ID=system
# For scripts/setup-stream.ts: the app's webhook (attendance for Previous), e.g.
# https://faceon.example.com/api/webhooks/stream. Stream can't reach localhost.
STREAM_WEBHOOK_URL=

# Who can host and administer
ADMIN_EMAILS=
HOST_ALLOWLIST=

# Guardrails (keep usage inside free tiers)
MAX_PARTICIPANTS_PER_MEETING=20
MAX_CONCURRENT_MEETINGS=10
MAX_MEETING_MINUTES=0
MEETINGS_PER_USER_PER_DAY=20
ALLOW_GUESTS=true
DEMO_MAX_MINUTES=15
DEMO_MAX_PARTICIPANTS=4
DEMO_MEETINGS_PER_DAY=3
ALONE_TIMEOUT_MINUTES=10
# Reminder emails a day at most, so account emails fit Resend's free 100 a day
REMINDER_EMAILS_PER_DAY=50

# Protects the daily cleanup, which also schedules reminder emails, from anyone but Vercel Cron
CRON_SECRET=

# Optional bot checks (Cloudflare Turnstile, a Managed widget): both keys, or no check
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Guest joins accept tokens passed on your site's own address; add others here, comma-separated
TURNSTILE_HOSTNAMES=
# Optional error reports (Sentry, or GlitchTip): the DSN turns them on. The rest uploads
# source maps at build time; SENTRY_URL only for GlitchTip or a self-hosted Sentry.
NEXT_PUBLIC_SENTRY_DSN=
# An organization token (Sentry: Settings → Developer Settings → Organization Tokens).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=
# Optional page view counts (Vercel Web Analytics): 1 turns them on. Only on Vercel, with
# Web Analytics enabled for the project; elsewhere /_vercel/insights doesn't exist.
NEXT_PUBLIC_VERCEL_ANALYTICS=
# The Content Security Policy: report-only (the default), enforce, or off
CONTENT_SECURITY_POLICY=

# Settings → Admin → Usage this month, which emails the admins at 80% and 100% of each free
# allowance. Defaults: Stream's free $100 is 333,000 participant-minutes of audio or SD
# video; Resend's free plan, 100 emails a day and 3,000 a month; Neon's Free plan, 100
# compute hours a month. Set yours if your plans differ; 0 means no limit.
USAGE_STREAM_MINUTES=
USAGE_EMAILS_PER_DAY=
USAGE_EMAILS_PER_MONTH=
USAGE_NEON_CU_HOURS=
# Optional: Neon's API, for the database's compute hours on that page. A project-scoped API
# key (Neon: your organization's Settings → API keys → Create new → Project-scoped) and the
# project's ID (its Settings → General: like misty-river-12345678, never a br-… branch ID).
# Without them, the page says how to add them.
NEON_API_KEY=
NEON_PROJECT_ID=
# Optional: a Resend API key with full access, only to list the account's emails, so the
# email meters count everything (other apps on the account, emails sent before the meter).
# RESEND_API_KEY works too if it has full access; a sending-only key can't list.
RESEND_USAGE_API_KEY=

# Not read yet: the LiveKit media provider. Setting these changes nothing today.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Browser tests (pnpm test:e2e; see AGENTS.md). They write test users to this database, so it
# must never be production's: a database off this machine needs E2E_ALLOW_REMOTE_DATABASE=1.
# Defaults: the app's own database, port 3100, and a server the tests start themselves.
E2E_DATABASE_URL=
E2E_ALLOW_REMOTE_DATABASE=
E2E_PORT=
E2E_BASE_URL=

# The desktop app (optional; desktop/RELEASING.md): the public repository whose GitHub
# Releases hold it, such as this one, as owner/name. /download and "Get the desktop app" read its latest release.
DESKTOP_RELEASES_REPO=
# Which of those builds are signed (Windows) or notarized (Mac): "windows", "mac" or
# "windows,mac". /download tells people how to open an unsigned one the first time.
DESKTOP_SIGNED=
