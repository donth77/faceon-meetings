# Copy to .env.local for local development. Never commit real values.
# Only NEXT_PUBLIC_* values reach the browser.

# App
# The name shown everywhere. `pnpm brand` makes the logo, icons and colors to match
# (DEPLOY.md, "Make it yours").
NEXT_PUBLIC_APP_NAME=FaceOn
# The public origin. On Vercel, set it to the production domain for Production and Preview:
# preview deployments send Google and GitHub sign-in through it.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public repo for "Found an issue? Submit" / "View source on GitHub"; leave empty to hide both links
NEXT_PUBLIC_REPO_URL=
# Who runs this copy and how to reach them, as the privacy policy and terms say (/privacy, /terms).
# Without an email, they point people to the repo's issues.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
# Whose laws govern the terms, after "the laws of", e.g. "the State of New York, USA". Without it,
# the terms name the place where the operator is based.
NEXT_PUBLIC_OPERATOR_JURISDICTION=
# AI notes (made in hosts' browsers, on-device or with their own AI key): "on" (the default) or "off"
NEXT_PUBLIC_AI_NOTES=

# Database (Neon): pooled URL for the app, direct URL for migrations and backups
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Wake a sleeping database when someone starts to sign in or join, so they don't wait the
# second it takes: "auto" (the default) does it for Neon, which sleeps after five idle
# minutes unless that's turned off; "off" if yours never sleeps; "on" for another database
# that sleeps.
DATABASE_WAKE_ON_INTENT=

# Auth (Better Auth + OAuth apps)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Calendar sync for hosts who connect it (Settings → Calendar): "on" (the default) or
# "off". It uses the Google client above: turn on the Google Calendar API in its Google Cloud
# project and add the calendar.events.owned scope to its consent screen. Off leaves the
# calendar links on each meeting's page.
GOOGLE_CALENDAR_SYNC=
# The Google Workspace add-on (google-addon/): its OAuth client ID, which is the `aud` of
# the identity tokens it sends (the add-on's first test run logs it). Unset, the add-on's
# API (/api/addon/google/*) is off.
GOOGLE_ADDON_CLIENT_ID=
# The add-on's Google Workspace Marketplace listing, once it's listed: Settings → Calendar
# and the landing page then offer it.
NEXT_PUBLIC_GOOGLE_ADDON_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: more origins that may use sign-in (comma-separated exact origins, e.g. a second
# domain). Production, each Vercel deployment's own address and localhost (in development)
# are trusted already. Never use a wildcard: a password-reset link must only lead back here.
BETTER_AUTH_TRUSTED_ORIGINS=
# Account emails (verify your address, reset your password) through Resend. Without both,
# email sign-up is hidden in production; in development the emails print to the server log.
# EMAIL_FROM uses a domain verified in Resend, e.g. FaceOn <no-reply@mail.example.com>
RESEND_API_KEY=
EMAIL_FROM=
# Signs guest cookies and rejoin tickets
GUEST_SESSION_SECRET=

# Media providers, in priority order: stream, livekit
MEDIA_PROVIDERS=stream
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=
STREAM_SYSTEM_USER_ID=system
# For scripts/setup-stream.ts: the app's webhook (attendance for Previous), e.g.
# https://faceon.example.com/api/webhooks/stream. Stream can't reach localhost.
STREAM_WEBHOOK_URL=

# Who can host and administer
ADMIN_EMAILS=
HOST_ALLOWLIST=

# Guardrails (keep usage inside free tiers)
MAX_PARTICIPANTS_PER_MEETING=20
MAX_CONCURRENT_MEETINGS=10
MAX_MEETING_MINUTES=0
MEETINGS_PER_USER_PER_DAY=20
ALLOW_GUESTS=true
DEMO_MAX_MINUTES=15
DEMO_MAX_PARTICIPANTS=4
DEMO_MEETINGS_PER_DAY=3
ALONE_TIMEOUT_MINUTES=10
# Reminder emails a day at most, so account emails fit Resend's free 100 a day
REMINDER_EMAILS_PER_DAY=50

# Protects the scheduled endpoints: the daily cleanup, and reminder emails every 5 minutes
CRON_SECRET=
# For `pnpm cron:setup` only: cron-job.org's API key, to create the reminder emails' job
CRON_JOB_DOT_ORG_API_KEY=

# Optional bot checks (Cloudflare Turnstile, a Managed widget): both keys, or no check
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Guest joins accept tokens passed on your site's own address; add others here, comma-separated
TURNSTILE_HOSTNAMES=
# Optional error reports (Sentry, or GlitchTip): the DSN turns them on. The rest uploads
# source maps at build time; SENTRY_URL only for GlitchTip or a self-hosted Sentry.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=
# The Content Security Policy: report-only (the default), enforce, or off
CONTENT_SECURITY_POLICY=

# Not read yet: the LiveKit media provider. Setting these changes nothing today.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Browser tests (pnpm test:e2e; see AGENTS.md). They write test users to this database, so it
# must never be production's: a database off this machine needs E2E_ALLOW_REMOTE_DATABASE=1.
# Defaults: the app's own database, port 3100, and a server the tests start themselves.
E2E_DATABASE_URL=
E2E_ALLOW_REMOTE_DATABASE=
E2E_PORT=
E2E_BASE_URL=

# Optional: generates default backgrounds when no public-domain image fits (never used at runtime)
OPENAI_API_KEY=

# The desktop app (optional; desktop/README.md): its public releases repository, as
# owner/name. /download and "Get the desktop app" read its latest release.
DESKTOP_RELEASES_REPO=
